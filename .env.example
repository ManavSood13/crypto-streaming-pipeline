# Copy to .env and fill in. .env is gitignored; this file is not.
# Every value is optional: the defaults target a local PostgreSQL.

# ----------------------------------------------------------------
# Database - option A: individual settings (used by this project)
# ----------------------------------------------------------------

PGHOST=localhost
PGPORT=5432
PGDATABASE=crypto_pipeline
PGUSER=
PGPASSWORD=

# Managed databases require TLS. Set to "require" for Supabase,
# Neon, Railway and similar. Leave unset for a local socket.
# PGSSLMODE=require

# ----------------------------------------------------------------
# Database - option B: a single connection string
# If set, this OVERRIDES every PG* value above.
# ----------------------------------------------------------------

# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ----------------------------------------------------------------
# Dashboard
# ----------------------------------------------------------------

# How often the dashboard refreshes. Use 3s against a local database;
# 15s or more against a hosted one, to limit round trips.
REFRESH_INTERVAL=15s

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------

LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
